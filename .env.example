# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value here is intentionally empty — tests/test_no_secrets.py asserts it.

# --- Dev loop switches (see PLAN_FAZEROPS.md §5) ---
# fixture | live
FAZEROPS_MODE=fixture
# stub | cassette | record | nova | demo | sonnet
FAZEROPS_LLM=stub

# --- AWS (not needed in fixture+stub mode) ---
AWS_REGION=
AWS_PROFILE=

# --- Slack (W25) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# --- GitHub collector (W11, P2) ---
GITHUB_TOKEN=
