# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value here is intentionally empty — tests/test_no_secrets.py asserts it.

# --- Dev loop switches (see PLAN_FAZEROPS.md §5) ---
# fixture | live
FAZEROPS_MODE=fixture
# stub | cassette | record | nova | demo | sonnet | gemini
FAZEROPS_LLM=stub

# --- AWS (not needed in fixture+stub mode) ---
AWS_REGION=
AWS_PROFILE=
# The role an approved AWS action (restore_db_parameter) assumes, with the approver as its
# SourceIdentity. Unset: those actions are refused. Policies and commands: config/aws/README.md
FAZEROPS_ACTOR_ROLE_ARN=

# --- Gemini (plan §9.2 — the active inference path while Bedrock is blocked) ---
GEMINI_API_KEY=
# vertex (default, a Vertex AI express key) | aistudio (an AI Studio key)
FAZEROPS_GEMINI_BACKEND=
# Live runs only: cassette replay always uses the defaults, and recording refuses anything else. A model
# with no entry in agents/budget.py is metered at the most expensive known rate.
FAZEROPS_GEMINI_MODEL_ORCHESTRATOR=
FAZEROPS_GEMINI_MODEL_CORRELATOR=
FAZEROPS_GEMINI_MODEL_PROPOSER=
FAZEROPS_GEMINI_MODEL_WRITER_AUTHOR=
# off | minimal | low (default) | medium | high. Gemini 3 models only; use off for older ones.
FAZEROPS_GEMINI_THINKING=
# AgentCore Runtime only: the Identity API-key provider holding the Gemini key (set with `agentcore deploy
# --env`, never the key itself). The invoke must name a runtime user for Identity to issue it.
FAZEROPS_GEMINI_KEY_PROVIDER=

# --- Session store (W29, record/store.py) ---
# none (default) | dynamodb | agentcore-memory. The automation server and the AgentCore Runtime both write.
FAZEROPS_SESSION_STORE=
# Default fazerops-incident-sessions. The region is the store's, not the collectors' (sa-east-1).
FAZEROPS_SESSION_TABLE=
FAZEROPS_SESSION_REGION=
FAZEROPS_SESSION_MEMORY_ID=
# The deployed Runtime, for `pytest -m agentcore` (not free: one live Gemini investigation per run).
FAZEROPS_AGENTCORE_RUNTIME_ARN=

# --- Slack (W25) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# --- GitHub collector (W11, P2) ---
GITHUB_TOKEN=

# --- Catalog growth (Phase G) ---
# Where the automation server and the growth job keep the durable ledger and gap signals (default .fazerops).
FAZEROPS_STATE_DIR=
# HMAC key the ledger's deployment signs PR evidence with; the same value is the CI secret. Unset, bundles
# are written unattested and CI rejects their commits. It also signs the ledger's own hash chain: a ledger
# started without it stays unsigned (`python -m fazerops.actions.growth sign-ledger` signs it, writers
# stopped), and a signed ledger refuses appends from a process that lacks it.
FAZEROPS_EVIDENCE_KEY=
# kubeconfig context reserved for W43's containment runs. Required: the sandbox never falls back to the
# current context, which for a process that remediates production is the production cluster.
FAZEROPS_SANDBOX_CONTEXT=
# That cluster's API-server audit log, as a readable file (default: the collector's).
FAZEROPS_SANDBOX_AUDIT_LOG=
# How often actions.server runs the growth job (default 60; 0 disables), and the repository and revision
# it commits attested bundles into, on local branches (unset: bundles only, never pushed).
FAZEROPS_GROWTH_EVERY_MINUTES=
FAZEROPS_GROWTH_REPO=
FAZEROPS_GROWTH_BASE=
# 1 to push committed branches and open their pull requests with your gh credentials (outward-facing).
FAZEROPS_GROWTH_OPEN_PR=

# --- GitHub repositories FazerOps watches ---
# service=owner/repo[,...]: the company's application repositories each service's radius watches, replacing
# the manifest's placeholders. Pushes and merges there appear in that service's briefs.
FAZEROPS_SERVICE_REPOS=
